---
import { Icon } from 'astro-icon/components';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/formacion', label: 'Formación' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === currentPath;
---

<header class="sticky top-0 z-50 bg-main border-b border-border-subtle">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="font-display text-lg font-semibold text-primary">
      Jorge<span class="text-accent">.</span>Reyes
    </a>

    <nav class="hidden sm:flex sm:ml-auto gap-8 font-mono text-sm text-secondary">
      {links.map(link => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'relative pb-1 hover:text-accent transition-colors duration-300',
            isActive(link.href) && 'text-accent border-b-2 border-accent',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4 sm:gap-0">
    <button
      type="button"
      data-theme-toggle
      aria-label="Cambiar a tema claro"
      aria-pressed="false"
      class="sm:ml-8 relative w-5 h-5 text-secondary hover:text-accent transition-colors duration-300 cursor-pointer"
    >
      <Icon name="lucide:sun" class="w-5 h-5 light:hidden" />
      <Icon name="lucide:moon" class="w-5 h-5 hidden light:block" />
    </button>

    <button
      id="menu-toggle"
      class="sm:hidden relative w-6 h-6 text-primary hover:text-accent transition-colors duration-300 cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <Icon
        name="lucide:menu"
        id="icon-menu"
        class="w-6 h-6 absolute inset-0 transition-all duration-300 opacity-100 rotate-0"
      />
      <Icon
        name="lucide:x"
        id="icon-close"
        class="w-6 h-6 absolute inset-0 transition-all duration-300 opacity-0 -rotate-90"
      />
    </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="sm:hidden absolute inset-x-0 top-full flex flex-col bg-main border-b border-border-subtle px-6 pb-5 font-mono text-sm text-secondary shadow-lg
           transition-all duration-300 ease-out origin-top
           opacity-0 -translate-y-2 scale-y-95 pointer-events-none invisible"
  >
    {links.map(link => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
        class:list={[
          'py-2.5 border-b border-border-subtle hover:text-accent transition-colors duration-300 last:border-b-0',
          isActive(link.href) && 'text-accent',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initThemeToggle } from '@/scripts/theme';

  document.addEventListener('astro:page-load', initThemeToggle);

  const OPEN_CLASSES = ['opacity-100', 'translate-y-0', 'scale-y-100'];
  const CLOSED_CLASSES = ['opacity-0', '-translate-y-2', 'scale-y-95', 'pointer-events-none', 'invisible'];

  function initMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !menu || !iconMenu || !iconClose) return;

    function openMenu() {
      menu!.classList.remove(...CLOSED_CLASSES);
      menu!.classList.add(...OPEN_CLASSES);
      iconMenu!.classList.remove('opacity-100', 'rotate-0');
      iconMenu!.classList.add('opacity-0', 'rotate-90');
      iconClose!.classList.remove('opacity-0', '-rotate-90');
      iconClose!.classList.add('opacity-100', 'rotate-0');
      toggle!.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      menu!.classList.remove(...OPEN_CLASSES);
      menu!.classList.add(...CLOSED_CLASSES);
      iconMenu!.classList.remove('opacity-0', 'rotate-90');
      iconMenu!.classList.add('opacity-100', 'rotate-0');
      iconClose!.classList.remove('opacity-100', 'rotate-0');
      iconClose!.classList.add('opacity-0', '-rotate-90');
      toggle!.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
