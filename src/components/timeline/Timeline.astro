---
interface TimelineEntry {
  period: string;
  role: string;
  place: string;
  location?: string;
  points?: string[];
}
interface Props {
  items: TimelineEntry[];
}
const { items } = Astro.props;
---

<ol class="flex flex-col">
  {items.map((item, i) => (
    <li data-reveal class="flex gap-6">
      <div class="flex flex-col items-center shrink-0 w-4" aria-hidden="true">
        <span class="mt-2 w-3.5 h-3.5 rounded-full bg-accent ring-[5px] ring-accent/20"></span>
        {i < items.length - 1 && <span class="flex-1 w-px bg-border-strong mt-2"></span>}
      </div>
      <div class="min-w-0 pb-11 space-y-3">
        <p class="font-mono text-xs sm:text-sm text-accent">{item.period}</p>
        <h3 class="font-display font-semibold text-2xl sm:text-[1.75rem] leading-tight text-primary">{item.role}</h3>
        <p class="text-sm sm:text-base text-secondary">{item.place}{item.location && ` · ${item.location}`}</p>
        {item.points && item.points.length > 0 && (
          <ul class="pl-5 list-disc space-y-2 text-sm sm:text-base text-primary leading-relaxed">
            {item.points.map(point => <li>{point}</li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>
