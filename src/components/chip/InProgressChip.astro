---
import TechIcon from '@/components/TechIcon.astro';

interface Props {
  name: string;
  icon: string;
  detail?: string;
  delay?: number;
}

const { name, icon, detail, delay } = Astro.props;
---

<div data-reveal data-reveal-delay={delay}>
  <div data-tilt class="flex items-center gap-3 px-4 py-2.5 bg-abyss-900 border border-dashed border-accent-dim rounded-lg hover:border-accent hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300">
    <span class="tilt-glare"></span>
    <TechIcon name={icon} class="tilt-pop w-6 h-6" />
    <div>
      <span class="font-mono text-xs text-primary block">{name}</span>
      {detail && <span class="text-[10px] text-secondary">{detail}</span>}
    </div>
  </div>
</div>
