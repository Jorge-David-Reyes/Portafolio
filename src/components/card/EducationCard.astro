---
import { Icon } from 'astro-icon/components';

interface Props {
  role: string;
  place: string;
  period: string;
}

const { role, place, period } = Astro.props;
---

<div data-reveal class="flex items-start gap-4 p-7 border border-border-strong rounded-2xl bg-surface/60">
  <div class="shrink-0 w-10 h-10 rounded-full bg-abyss-900 border border-accent flex items-center justify-center">
    <Icon name="lucide:graduation-cap" class="w-5 h-5 text-accent" />
  </div>
  <div>
    <h4 class="font-display font-semibold text-lg text-primary">{role}</h4>
    <p class="text-md text-secondary mt-1">{place}</p>
    <p class="font-mono text-sm text-accent mt-2">{period}</p>
  </div>
</div>