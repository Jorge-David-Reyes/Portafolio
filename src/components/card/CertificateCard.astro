---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface CertLink {
  label: string;
  icon: string;
  url: string;
}

interface Props {
  title: string;
  issuer: string;
  date: string;
  image: ImageMetadata;
  links: CertLink[];
}

const { title, issuer, date, image, links } = Astro.props;
---

<article data-reveal class="sm:h-full sm:flex sm:flex-col bg-surface border border-border-strong rounded-2xl overflow-hidden hover:border-accent-dim hover:-translate-y-1 hover:shadow-lg hover:shadow-elevation transition-all duration-300 group">
  <div class="aspect-[4/3] bg-abyss-900">
    <Image
      src={image}
      alt={`Certificado: ${title}`}
      class="w-full h-full object-cover"
    />
  </div>
  <div class="p-5 space-y-3 sm:flex-1 sm:flex sm:flex-col">
    <div>
      <h3 class="font-display font-semibold text-lg text-primary leading-snug sm:min-h-[2lh]">{title}</h3>
      <p class="font-mono text-xs text-secondary mt-1.5">{issuer} · {date}</p>
    </div>
    <div class="flex flex-wrap gap-2 sm:mt-auto">
      {links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-4 min-h-11 bg-abyss-900 border border-border-strong rounded-full font-mono text-xs text-primary hover:border-accent hover:text-accent transition-colors"
        >
          <Icon name={link.icon} class="w-4 h-4" />
          {link.label}
        </a>
      ))}
    </div>
  </div>
</article>