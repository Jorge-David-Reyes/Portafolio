---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface CertLink {
  label: string;
  icon: string;
  url: string;
}

interface Props {
  title: string;
  issuer: string;
  date: string;
  image: ImageMetadata;
  links: CertLink[];
}

const { title, issuer, date, image, links } = Astro.props;
---

<article data-reveal class="bg-surface border border-border-subtle rounded-lg overflow-hidden hover:border-accent-dim hover:-translate-y-1 hover:shadow-lg hover:shadow-black/30 transition-all duration-300 group">
  <div class="aspect-[4/3] bg-abyss-900">
    <Image
      src={image}
      alt={`Certificado: ${title}`}
      class="w-full h-full object-cover"
    />
  </div>
  <div class="p-4 space-y-3">
    <div>
      <h3 class="font-display font-semibold text-sm text-primary leading-snug">{title}</h3>
      <p class="font-mono text-[11px] text-secondary mt-1">{issuer} · {date}</p>
    </div>
    <div class="flex gap-2">
      {links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-3 py-1.5 bg-abyss-900 border border-border-subtle rounded font-mono text-[11px] text-secondary hover:border-accent hover:text-accent transition-colors"
        >
          <Icon name={link.icon} class="w-4 h-4" />
          {link.label}
        </a>
      ))}
    </div>
  </div>
</article>