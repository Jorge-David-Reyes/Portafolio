---
import { LayoutMain } from "@/layouts";
import { Timeline, EducationCard, PageHeader, Button } from '@/components';
import { experience, education } from '@/data/experience';
---

<LayoutMain
	title="Sobre mí | Jorge Reyes"
	description="Educación y experiencia profesional de Jorge Reyes."
>
	<div class="space-y-16">
		<PageHeader
			eyebrow="Sobre mí"
			description="Más de 2 años de experiencia como desarrollador Full Stack, especializado en Vue.js/Nuxt, TypeScript y Laravel. Actualmente amplío mis conocimientos hacia Ingeniería de Datos."
		>
			Ingeniero en Sistemas Inteligentes que <em class="font-normal text-accent">construye de punta a punta</em>.
		</PageHeader>

		<section class="grid lg:grid-cols-[1fr_2fr] gap-14 items-start">
			<div class="space-y-5">
				<h2 data-reveal class="font-mono text-xs tracking-[0.14em] uppercase text-secondary">Educación</h2>
				<EducationCard role={education.role} place={education.place} period={education.period} />
			</div>

			<div class="space-y-5">
				<h2 data-reveal class="font-mono text-xs tracking-[0.14em] uppercase text-secondary">Experiencia</h2>
				<Timeline items={experience} />
			</div>
		</section>

		<section data-reveal class="rounded-3xl border border-border-strong bg-[radial-gradient(ellipse_at_50%_0%,color-mix(in_srgb,var(--color-lagoon)_50%,transparent)_0%,transparent_70%)] px-8 py-10 flex flex-wrap items-center justify-between gap-6">
			<p class="font-display font-semibold text-2xl sm:text-3xl leading-tight text-primary flex-1 min-w-[16rem]">¿Hablamos? Estoy disponible para nuevas oportunidades.</p>
			<Button href="/contacto">Escríbeme</Button>
		</section>
	</div>
</LayoutMain>
