---
import { LayoutMain } from "@/layouts";
import { Button, SkillChip, InProgressChip, PixelAvatar } from '@/components';
import { Icon } from 'astro-icon/components';
import { skills, inProgress } from '@/data/skills';

const socials = [
  { name: 'GitHub', icon: 'simple-icons:github', href: 'https://github.com/Jorge-David-Reyes' },
  { name: 'LinkedIn', icon: 'simple-icons:linkedin', href: 'https://linkedin.com/in/jorge-reyes-2a998428a' },
];
---

<LayoutMain
	title="Jorge Reyes | Full Stack Developer | Aspiring Data Engineer"
	description="Portafolio de Jorge Reyes, desarrollador Full Stack (Vue/Nuxt, TypeScript, Laravel) en camino a Data Engineering."
>
	<div class="space-y-16">
		<section class="hero-grid relative overflow-hidden gap-8 items-start pt-6">
			<h1 data-reveal class="hero-name font-display text-4xl sm:text-5xl font-semibold tracking-tight text-primary">
				<span class="text-gradient">Jorge Reyes</span>
			</h1>

			<!-- <div data-reveal class="hero-avatar flex flex-col items-center gap-4">
				<PixelAvatar />
				<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface border border-border-subtle rounded-full font-mono text-xs text-secondary">
					<span class="relative flex h-2 w-2">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
					</span>
					Disponible para proyectos
				</div>
			</div> -->

			<p data-reveal class="hero-desc text-secondary text-base sm:text-lg max-w-xl leading-relaxed">
				Desarrollador Full Stack con más de 2 años de experiencia construyendo plataformas web completas: desde interfaces en Vue/Nuxt hasta backends en Laravel. Actualmente ampliando mi perfil hacia Data Engineering.
			</p>

			<div data-reveal class="hero-actions flex flex-wrap items-center gap-4 pt-2 font-body">
				<Button href="/proyectos">Ver proyectos</Button>
				<Button href="/cv/CV_Jorge_David_Reyes_Melendez.pdf" download variant="outline">
				Descargar CV <Icon name="lucide:download" class="w-4 h-4" />
				</Button>

				<div class="flex items-center gap-3 pl-2">
				{socials.map(social => (
					<a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="text-secondary hover:text-accent transition-colors">
					<Icon name={social.icon} class="w-7 h-7" />
					</a>
				))}
				</div>
			</div>
		</section>

		<section class="space-y-6">
			<h2 data-reveal class="font-display text-2xl font-medium text-primary">Habilidades</h2>
			<div data-reveal class="flex flex-wrap gap-3">
				{skills.map(skill => <SkillChip name={skill.name} icon={skill.icon} />)}
			</div>

			<div class="pt-2">
				<h3 data-reveal class="font-mono text-xs tracking-widest uppercase text-secondary mb-3">
					Actualmente en formación
				</h3>
				<div data-reveal class="flex flex-wrap gap-3">
					{inProgress.map(item => (
						<InProgressChip name={item.name} icon={item.icon} detail={item.detail} />
					))}
				</div>
			</div>
		</section>
	</div>
</LayoutMain>

<style>
.hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "name"
      "avatar"
      "desc"
      "actions";
  }
  .hero-name    { grid-area: name; }
  .hero-avatar  { grid-area: avatar; }
  .hero-desc    { grid-area: desc; }
  .hero-actions { grid-area: actions; }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 2fr 1fr;
      column-gap: 2rem;
      grid-template-areas:
        "name   avatar"
        "desc   avatar"
        "actions avatar";
    }
    .hero-avatar {
      align-items: flex-end;
    }
  }

.text-gradient {
    /* background-image: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-foam-100)
    ); */
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--color-accent);
  }
</style>
