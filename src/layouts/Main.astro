---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Footer, Header } from "@/components";

interface Props {
  title: string | null;
  description?: string;
  fillViewport?: boolean;
}
const { title, description, fillViewport = false } = Astro.props;
---

<html lang="es" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
      });
    </script>
    <ClientRouter />
  </head>
  <body
    class:list={[
      "flex flex-col min-h-dvh text-primary",
      fillViewport && "sm:h-dvh",
    ]}
  >
    <div class="fixed inset-0 -z-20 bg-lagoon" transition:persist="lagoon">
    </div>
    <canvas
      id="reveal-curtain"
      class="fixed inset-0 -z-10 pointer-events-none"
      transition:persist="reveal-curtain"></canvas>

    <Header />
    <main
      class:list={[
        "layout-main flex-1 w-full max-w-6xl mx-auto px-6 py-8",
        fillViewport && "sm:flex sm:flex-col sm:min-h-0",
      ]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initScrollReveal } from "@/scripts/scrollReveal";
  import { initRevealCurtain } from "@/scripts/revealCurtain";

  initRevealCurtain("reveal-curtain");
  document.addEventListener("astro:page-load", initScrollReveal);
</script>

<style is:global lang="scss">
  .no-scrollbar {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge viejo */
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge nuevo */
  }

  canvas#reveal-curtain {
    background-color: var(--color-main);
  }
  .js canvas#reveal-curtain {
    background-color: transparent;
  }

  /* ---- Reveal on scroll ---- */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal] {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .js [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(4px);
    }
  }
</style>
